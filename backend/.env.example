# RepoGuard backend settings
# HOW TO USE: copy this file, rename the copy to .env, and fill in your own keys.
# NEVER commit .env. Never put real keys in this file.

# --- Groq (MAIN provider) ---
# Free key: console.groq.com -> API Keys -> Create API Key
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1

# Max seconds to wait for one LLM reply before retrying
LLM_TIMEOUT=120

# --- Gemini (FALLBACK provider) ---
# Free key: aistudio.google.com -> Get API key
# To switch: put # in front of the 4 Groq lines above, remove # from these 3 lines.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.6-flash
# LLM_API_KEY=