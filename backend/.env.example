# RepoGuard backend settings
# HOW TO USE: copy this file, rename the copy to .env, and fill in your own keys.
# NEVER commit .env. Never put real keys in this file.

# --- Core backend settings ---
# Local Windows PostgreSQL. Percent-encode reserved password characters (for example @ as %40).
DATABASE_URL=postgresql+psycopg://postgres:<your-password>@localhost:5432/repoguard
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITLEAKS_BIN=gitleaks
OSV_API_URL=https://api.osv.dev/v1/querybatch
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=INFO

# --- Groq (MAIN provider) ---
# Free key: console.groq.com -> API Keys -> Create API Key
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1

# Max seconds to wait for one LLM reply before retrying
LLM_TIMEOUT=120

# --- Gemini (FALLBACK provider) ---
# Free key: aistudio.google.com -> Get API key
# To switch: put # in front of the 4 Groq lines above, remove # from these 3 lines.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.6-flash
# LLM_API_KEY=
