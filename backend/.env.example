# SQLite for local development; use a PostgreSQL URL for deployment.
DATABASE_URL=sqlite:///./repoguard.db
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=60
OSV_TIMEOUT_SECONDS=15
SCAN_TIMEOUT_SECONDS=120
REPOGUARD_SCAN_ROOT=
REPOGUARD_LOCAL_SCAN_ENABLED=false
CORS_ORIGINS=http://localhost:5173
GITLEAKS_BIN=
