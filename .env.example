# Copy this file to .env and fill in your real values.
# RepoGuard uses this for Gemini-backed AI remediation guidance.

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=your-gemini-api-key
LLM_BASE_URL=
LLM_TIMEOUT=60

# Optional: deployed Node commerce API URL. Keep blank for local Vite proxy use.
VITE_COMMERCE_API_BASE_URL=
